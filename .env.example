# ---------------------------------------------------------------------------
# EduIntel environment configuration.
# Copy to `.env` and fill in secrets. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# ---- App ----
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Security ----
# Generate a strong random value for any real deployment.
SECRET_KEY=change-me-in-production
# Leave empty to run without auth (demo). Set to require the X-API-Key header.
API_KEY=

# ---- Database ----
POSTGRES_USER=eduintel
POSTGRES_PASSWORD=eduintel
POSTGRES_DB=eduintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: overrides the POSTGRES_* fields if set.
# DATABASE_URL=postgresql+psycopg2://eduintel:eduintel@localhost:5432/eduintel

# ---- LLM / RAG ----
# Provider abstraction: gemini | openai | local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# OpenAI-compatible fallback (any endpoint implementing the OpenAI API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embeddings run locally (no key required) for reproducible, zero-cost RAG.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25

# ---- ML / data ----
RANDOM_SEED=42
# DATA_DIR and MODEL_DIR auto-anchor to the repo root when unset (recommended),
# so training and the API resolve the same folders. Uncomment to override.
# DATA_DIR=data
# MODEL_DIR=models
